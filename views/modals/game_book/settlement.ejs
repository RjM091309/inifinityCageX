    <script>
        $(document).ready(function() {
            function cleanValue(value) {
                if (value === undefined || value === null) return '0';
                var text = String(value).trim();
                return text.length ? text : '0';
            }

            function parseAmount(value) {
                var num = parseFloat(String(value || '').replace(/,/g, '').trim());
                return isNaN(num) ? 0 : num;
            }

            function formatAmount(value) {
                return Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
            }

            function formatInputWithCommas($input) {
                var raw = String($input.val() || '').replace(/,/g, '').trim();
                if (!raw) {
                    $input.val('');
                    return;
                }
                var normalized = raw.replace(/[^\d.]/g, '');
                var firstDot = normalized.indexOf('.');
                if (firstDot !== -1) {
                    normalized = normalized.slice(0, firstDot + 1) + normalized.slice(firstDot + 1).replace(/\./g, '');
                }
                var num = parseFloat(normalized);
                if (isNaN(num)) return;
                $input.val(num.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }));
            }

            function syncPayment($modal) {
                var fb = parseAmount($modal.find('#fb').val());
                var settlement = parseAmount($modal.find('#rollingSettlement').val());
                var payment = settlement - fb;
                $modal.find('#payment').val(formatAmount(payment));
            }

            function formatReceiptDateTime(dateText, timeText) {
                var dateValue = String(dateText || '').trim();
                var timeValue = String(timeText || '').trim();
                var formattedDate = dateValue;
                var formattedTime = timeValue;

                if (/^\d{4}-\d{2}-\d{2}$/.test(dateValue)) {
                    var dateParts = dateValue.split('-');
                    formattedDate = dateParts[1] + '/' + dateParts[2] + '/' + dateParts[0];
                }
                if (/^\d{2}:\d{2}:\d{2}$/.test(timeValue)) {
                    formattedTime = timeValue.slice(0, 5);
                }
                return cleanValue(formattedDate + ' ' + formattedTime);
            }

            function updateReceiptPrintData($modal) {
                var dateText = cleanValue($modal.find('#date').text());
                var timeText = cleanValue($modal.find('#time').text());
                var accountRaw = cleanValue($modal.find('#accNo').text());
                var accountParts = accountRaw.split('-');
                var accountCode = cleanValue(accountParts[0]);
                var accountName = cleanValue(accountParts.slice(1).join('-'));

                $modal.find('#printReceiptDateTime').text(formatReceiptDateTime(dateText, timeText));
                $modal.find('#printReceiptAccount').text(accountCode);
                $modal.find('#printReceiptName').text(accountName);
                $modal.find('#printReceiptBuyIn').text(cleanValue($modal.find('#buyIn').val()));
                $modal.find('#printReceiptCashOut').text(cleanValue($modal.find('#chipsReturn').val()));
                $modal.find('#printReceiptWinLoss').text(cleanValue($modal.find('#winLoss').val()));
                $modal.find('#printReceiptRolling').text(cleanValue($modal.find('#rolling').val()));
                $modal.find('#printReceiptSettlement').text(cleanValue($modal.find('#rollingSettlement').val()));
                $modal.find('#printReceiptFnb').text(cleanValue($modal.find('#fb').val()));
                $modal.find('#printReceiptIncidential').text('0');
                $modal.find('#printReceiptTotal').text(cleanValue($modal.find('#payment').val()));
            }

            function getReceiptPrintStyles() {
                return '@page{size:auto;margin:6mm;}html,body{margin:0;padding:0;}body{font-family:Arial,sans-serif;color:#000;} .receipt-print-content{width:100%;max-width:200mm;margin:0 auto;font-size:5mm;line-height:1.3;} .receipt-brand{text-align:center;font-weight:700;font-size:7.5mm;margin:0;letter-spacing:.3px;} .receipt-subtitle{text-align:center;font-weight:700;font-size:6.4mm;margin:4mm 0 0;} .receipt-datetime{text-align:center;font-weight:700;font-size:5.6mm;margin:2mm 0 4mm;} .receipt-line{border-top:1px solid #000;width:90%;margin:4mm auto;} .receipt-row{display:flex;justify-content:space-between;align-items:baseline;gap:3mm;width:72%;min-width:120mm;margin:2mm auto;} .receipt-row span:first-child{width:35%;text-align:right;font-weight:700;white-space:nowrap;} .receipt-row span:last-child{width:35%;text-align:left;font-weight:700;white-space:nowrap;} .receipt-total span{font-size:7mm;}';
            }

            function openReceiptPrintWindow($modal) {
                var receiptHtml = $modal.find('.receipt-print-only').html();
                var iframe = document.createElement('iframe');
                iframe.style.position = 'fixed';
                iframe.style.right = '0';
                iframe.style.bottom = '0';
                iframe.style.width = '0';
                iframe.style.height = '0';
                iframe.style.border = '0';
                iframe.setAttribute('aria-hidden', 'true');
                document.body.appendChild(iframe);

                var iframeDoc = iframe.contentWindow.document;
                iframeDoc.open();
                iframeDoc.write('<!doctype html><html><head><title>Settlement Receipt</title><style>' + getReceiptPrintStyles() + '</style></head><body>' + receiptHtml + '</body></html>');
                iframeDoc.close();

                setTimeout(function() {
                    iframe.contentWindow.focus();
                    iframe.contentWindow.print();
                    setTimeout(function() {
                        if (iframe && iframe.parentNode) iframe.parentNode.removeChild(iframe);
                    }, 500);
                }, 100);
            }

            function updateSettlementFromRollingAndRate($modal) {
                if (!Number($modal.data('edit-mode'))) return;
                var rolling = parseAmount($modal.find('#rolling').val());
                var rate = parseAmount($modal.find('#rollingRate').val());
                var settlement = Math.round((rolling * rate) / 100);
                $modal.find('#rollingSettlement').val(settlement.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 }));
                syncPayment($modal);
            }

            function captureSnapshot($modal) {
                $modal.data('settlement-snapshot', {
                    buyIn: $modal.find('#buyIn').val(),
                    chipsReturn: $modal.find('#chipsReturn').val(),
                    winLoss: $modal.find('#winLoss').val(),
                    rolling: $modal.find('#rolling').val(),
                    rollingRate: $modal.find('#rollingRate').val(),
                    rollingSettlement: $modal.find('#rollingSettlement').val(),
                    fb: $modal.find('#fb').val(),
                    payment: $modal.find('#payment').val(),
                    transType: $modal.find('input[name="txtTransType"]:checked').val() || ''
                });
            }

            function restoreSnapshot($modal) {
                var s = $modal.data('settlement-snapshot');
                if (!s) return;
                $modal.find('#buyIn').val(s.buyIn);
                $modal.find('#chipsReturn').val(s.chipsReturn);
                $modal.find('#winLoss').val(s.winLoss);
                $modal.find('#rolling').val(s.rolling);
                $modal.find('#rollingRate').val(s.rollingRate);
                $modal.find('#rollingSettlement').val(s.rollingSettlement);
                $modal.find('#fb').val(s.fb);
                $modal.find('#payment').val(s.payment);
                $modal.find('input[name="txtTransType"]').prop('checked', false);
                if (s.transType) {
                    $modal.find('input[name="txtTransType"][value="' + s.transType + '"]').prop('checked', true);
                }
            }

            function setEditMode($modal, enabled) {
                var isSettled = Number($modal.data('is-settled')) === 1;
                var fakeActive = Number($modal.data('fake-settle-active')) === 1;
                $modal.data('edit-mode', enabled ? 1 : 0);

                $modal.find('#submit-settlement-btn').toggle(!enabled && !isSettled);
                $modal.find('.deposit-cashout-row').toggle(!enabled && !isSettled);
                $modal.find('#settlement-telegram-opts').toggle(enabled || (!isSettled && fakeActive && !enabled));
                $modal.find('#close-settlement-btn').toggle(!enabled);

                $modal.find('#edit-settlement-btn').text(enabled ? 'Done' : 'Edit');
                $modal.find('#buyIn, #chipsReturn, #winLoss, #rollingSettlement, #fb, #payment').prop('readonly', true);
                $modal.find('#rolling, #rollingRate').prop('readonly', !enabled);
            }

            $('#modal-settlement').on('shown.bs.modal', function() {
                var $modal = $(this);
                $modal.removeData('settlement-snapshot');
                $modal.find('#settleSendAgent, #settleSendCage').prop('checked', false);
                setEditMode($modal, false);
                syncPayment($modal);
            });

            $('#modal-settlement').on('hidden.bs.modal', function() {
                var $modal = $(this);
                $modal.removeData('settlement-snapshot');
                setEditMode($modal, false);
            });

            $('#edit-settlement-btn').on('click', function() {
                var $modal = $(this).closest('.modal');
                var isEditMode = !!$modal.data('edit-mode');
                var isSettled = Number($modal.data('is-settled')) === 1;
                var gameId = $modal.find('input[name="game_id_settle"]').val();

                if (!isEditMode) {
                    captureSnapshot($modal);
                    setEditMode($modal, true);
                    updateSettlementFromRollingAndRate($modal);
                    return;
                }

                function finishDone(agentSent, cageSent) {
                    if (!isSettled) {
                        restoreSnapshot($modal);
                    }
                    setEditMode($modal, false);
                    $modal.removeData('settlement-snapshot');
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'success',
                            title: 'Done',
                            text: (agentSent || cageSent) ? 'Done. Telegram sent.' : 'Done.',
                            confirmButtonText: 'OK'
                        });
                    }
                }

                function putFakeSettleThenFinish(agentSent, cageSent) {
                    if (!gameId) return finishDone(false, false);
                    $.ajax({
                        url: '/game_list/' + encodeURIComponent(gameId) + '/settlement_fake_settle',
                        type: 'PUT',
                        data: { fake_settle: 1 },
                        success: function() {
                            if (!isSettled) {
                                $modal.data('fake-settle-active', 1);
                            }
                            finishDone(agentSent, cageSent);
                        },
                        error: function() {
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({ icon: 'error', title: 'Error', text: 'Could not save settlement status. Try again.', confirmButtonText: 'OK' });
                            }
                        }
                    });
                }

                syncPayment($modal);

                var sendAgent = $modal.find('#settleSendAgent').is(':checked');
                var sendCage = $modal.find('#settleSendCage').is(':checked');

                if (sendAgent || sendCage) {
                    $.ajax({
                        type: 'POST',
                        url: '/settlement_slip_telegram',
                        data: $('#add_settlement').serialize(),
                        success: function() {
                            putFakeSettleThenFinish(sendAgent, sendCage);
                        },
                        error: function(xhr) {
                            var msg = 'Could not send Telegram.';
                            if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({ icon: 'error', title: 'Error', text: msg, confirmButtonText: 'OK' });
                            }
                        }
                    });
                    return;
                }

                putFakeSettleThenFinish(false, false);
            });

            $('#rolling, #rollingRate').on('input', function() {
                var $modal = $(this).closest('.modal');
                if (!$modal.data('edit-mode')) return;
                if (this.id === 'rolling') {
                    formatInputWithCommas($(this));
                }
                updateSettlementFromRollingAndRate($modal);
            });

            $('#print-settlement-btn').on('click', function() {
                var $modal = $(this).closest('.modal');
                syncPayment($modal);
                updateReceiptPrintData($modal);
                openReceiptPrintWindow($modal);
            });
        });
    </script>