                          </div>
                          <div class="mb-2">
                              <label class="form-label mb-1">Deposit</label>
                              <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number" class="form-control" id="splitDepCC" placeholder="CC Chips" />
                          </div>
