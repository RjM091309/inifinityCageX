<!-- Account Details Modal -->
<div class="modal fade" id="modal-account-details" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="staticBackdropLiveLabel">Guest Portal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Left Side: Account Photo & Details -->
                    <div class="col-xl-3 col-lg-4">
                        <div class="card">
                            <div class="header-title d-flex justify-content-center">
                                <h4 class="card-title">
                                    <span id="agent_code"></span> - <span id="account_name"></span>
                                </h4>
                            </div>
                            <div class="card-body">
                                <form id="add_new_account_details_alt">
                                    <input type="hidden" id="account_id_add" name="txtAccountId">
                                    <input type="hidden" id="total_balanceGuest" name="totalBalanceGuest" />
                                    <img id="zoomed-image" src="" alt="Zoomed Account Photo"> 
                                    <div class="form-group">
                                        <div class="d-flex justify-content-center align-items-center">
                                            <div class="profile-img-edit position-relative d-flex justify-content-center align-items-center flex-wrap">
                                                <!-- Primary account photo -->
                                                <img id="account_photo" src="../../assets/images/avatars/01.png" alt="Account Photo" class="theme-color-default-img profile-pic rounded avatar-100"> 
                                                <!-- Iba pang avatar options... -->
                                                <button type="button" class="upload-icone bg-primary account-photo-upload-label p-0 d-inline-flex align-items-center justify-content-center" id="btn-open-change-photo" title="Change photo">
                                                    <svg class="upload-button icon-14" width="14" viewBox="0 0 24 24" pointer-events="none">
                                                        <path fill="#ffffff" d="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group">
                                        <table id="dataTable" class="table table-vcenter table-hover" style="background-color: #f9f9f9; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                            <thead>
                                                <tr>
                                                    <th class="text-center bg-secondary text-white" style="width: 100%; font-size: 12px; padding: 10px 0;"><%= __('modal_account_details.total_balance') %></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="fw-bold text-center" style="font-size: 24px; color: #333;">
                                                        <span class="total_balance"></span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-group d-none" id="credit-iou-card">
                                        <table class="table table-vcenter table-hover" style="background-color: #f9f9f9; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                            <thead>
                                                <tr>
                                                    <th class="text-center text-white" style="width: 100%; font-size: 12px; padding: 10px 0; background-color: #1e3a5f;"><%= __('modal_account_details.credit_iou') %></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="fw-bold text-center" style="font-size: 24px; color: #333;">
                                                        <span class="credit_balance"></span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-group">
                                        <div class="form-check">
                                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="1" id="cash_trans" name="txtTrans">
                                            <label class="form-check-label" for="cash_trans">
                                                <span class="d-flex align-items-center"><%= __('modal_account_details.deposit') %></span>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="2" id="deposit_trans" name="txtTrans">
                                            <label class="form-check-label" for="deposit_trans">
                                                <span class="d-flex align-items-center"><%= __('modal_account_details.withdraw') %></span>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" value="3" id="issue_trans" name="txtTrans">
                                            <label class="form-check-label" for="issue_trans">
                                                <span class="d-flex align-items-center"><%= __('modal_account_details.credit') %></span>
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group">
                                        <input type="text" onkeypress="return onlyNumberKey(event)" data-type="number"
                                               class="form-control txtAmount txtAmount_alt" name="txtAmount" placeholder="<%= __('modal_account_details.amount_placeholder') %>" required>
                                    </div>
                                    <div class="form-group">
                                        <input type="text" name="txtRemarks" class="form-control remarks remarks_alt" placeholder="<%= __('modal_account_details.remarks_placeholder') %>">
                                    </div>
                                    
                                    <div class="form-group">
                                        <input class="form-check-input mb-3" type="checkbox" id="sendToTelegram" name="sendToTelegram" style="display: none;" checked>
                                        <label class="form-check-label ms-2" for="sendToTelegram" style="display: none;">
                                            <%= __('modal_account_details.send_to_telegram') %>
                                        </label>
                                        <button type="submit" class="btn btn-primary-subtle w-100">
                                            <i class="fa fa-check-circle me-1"></i><%= __('modal_account_details.update') %>
                                        </button>
                                    </div>
                                    
                                    <div class="form-group mb-0">
                                        <button type="button" class="btn btn-info-subtle w-100" id="balanceCheckBtn">
                                            <i class="fa fa-exclamation-circle me-1"></i> <%= __('modal_account_details.balance_check') %>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-9 col-lg-8">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="header-title flex-grow-1 min-w-0">
                                    <div class="d-flex flex-nowrap align-items-center gap-2 w-100" style="min-width: 0;">
                                        <h4 class="card-title mb-0 flex-shrink-0 text-nowrap"><%= __('modal_account_details.transaction_history') %></h4>
                                        <input type="text" id="agent_remarks_notice" class="form-control form-control-sm flex-grow-1 min-w-0" style="min-width: 5rem;" placeholder="<%= __('modal_account_details.remarks_placeholder') %>" autocomplete="off" maxlength="5000" aria-label="<%= __('modal_account_details.agent_remarks') %>">
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <!-- Removed daterangepicker input and filter button -->
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="text-end mb-4">
                                    <button class="btn btn-sm btn-secondary" id="btn-passport-details">Passport Details</button>
                                    <button class="btn btn-sm btn-primary" onclick="game_history($('#account_id').val() || $('#account_id_add').val())">Game History</button>
                                    <button class="btn btn-sm btn-info" onclick="transfer_account()"><%= __('modal_account_details.transfer_account') %></button>                       
                                    <button class="btn btn-sm btn-success" onclick="export_data()"><%= __('modal_account_details.export') %></button>
                                   
                                </div>
                                <input type="hidden" id="account_id">
                                <table id="accountDetails" class="table table-bordered nowrap table-responsive" style="width: 100%;">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 150px;"><%= __('modal_account_details.date') %></th>
                                            <th class="text-center" style="width: 200px;"><%= __('modal_account_details.transaction') %></th>
                                            <th class="text-center" style="width: 100px;"><%= __('modal_account_details.amount') %></th>
                                            <th class="text-center" style="width: 150px;"><%= __('modal_account_details.remarks') %></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
                        <%= __('modal_account_details.close') %>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Passport Details Modal -->
<div class="modal fade" id="modal-passport-details" tabindex="-1" aria-labelledby="modalPassportDetailsLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content passport-details-modal-content border-0 shadow-lg overflow-hidden">
            <div class="modal-header passport-details-header py-3 px-4">
                <h5 class="modal-title d-flex align-items-center gap-2 fw-semibold" id="modalPassportDetailsLabel">
                    <i class="fa fa-id-card"></i> Passport Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white">
                <div id="passport-details-loading" class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"><span class="visually-hidden">Loading...</span></div>
                    <p class="text-muted mb-0">Loading passport details...</p>
                </div>
                <div id="passport-details-empty" class="text-center py-5 d-none">
                    <div class="passport-empty-icon mb-3">
                        <i class="fa fa-id-card-o text-secondary"></i>
                    </div>
                    <p class="text-muted mb-0">No passport details available for this agent.</p>
                </div>
                <div id="passport-details-content" class="d-none">
                    <div class="row g-4 align-items-stretch">
                        <div class="col-12 col-md-5 d-flex">
                            <div class="passport-image-wrapper rounded-3 overflow-hidden position-relative w-100 d-flex align-items-center justify-content-center">
                                <img id="passport-detail-image" src="" alt="Passport" class="passport-detail-img w-100">
                                <div class="passport-hover-hint"><i class="fa fa-search-plus me-1"></i>Hover to enlarge</div>
                                <img id="passport-zoomed-image" src="" alt="Passport zoomed" class="passport-zoomed">
                            </div>
                        </div>
                        <div class="col-12 col-md-7 d-flex">
                            <div class="passport-details-card rounded-3 overflow-hidden w-100">
                                <table class="table table-borderless passport-details-table mb-0">
                                    <tbody>
                                        <tr><th>Type</th><td id="p-doc-type">—</td></tr>
                                        <tr><th>Country Code</th><td id="p-country">—</td></tr>
                                        <tr><th>Passport No</th><td id="p-passport-no">—</td></tr>
                                        <tr><th>Full Name</th><td id="p-full-name">—</td></tr>
                                        <tr><th>Nationality</th><td id="p-nationality">—</td></tr>
                                        <tr><th>Date of Birth</th><td id="p-dob">—</td></tr>
                                        <tr><th>Expiry Date</th><td id="p-expiry">—</td></tr>
                                        <tr><th>Gender</th><td id="p-gender">—</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Change Photo Modal (sibling so Bootstrap can show it; Guest Portal will show again when this closes) -->
<div class="modal fade" id="modal-change-photo" tabindex="-1" aria-labelledby="modalChangePhotoLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="modalChangePhotoLabel">Change Photo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12 col-md-5 text-center">
                        <label class="form-label small text-muted mb-1">Current / Previous</label>
                        <img id="change-photo-previous" src="" alt="Previous" class="change-photo-preview rounded border">
                    </div>
                    <div class="col-12 col-md-7">
                        <label class="form-label small text-muted mb-1">New image (drag & drop or click)</label>
                        <div id="change-photo-dropzone" class="change-photo-dropzone rounded border border-2 border-dashed text-center p-4">
                            <input type="file" id="change-photo-file-input" accept="image/*" class="d-none">
                            <div id="change-photo-placeholder">
                                <i class="fa fa-cloud-upload fa-2x text-secondary mb-2"></i>
                                <p class="small text-muted mb-0">Drag image here or click to browse</p>
                            </div>
                            <img id="change-photo-new-preview" src="" alt="New preview" class="change-photo-preview rounded d-none">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-alt-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="change-photo-save-btn" disabled>Save Photo</button>
            </div>
        </div>
    </div>
</div>

<style>

    /* Zoomed image styles – show whole image on hover (no crop) */
#zoomed-image {
    display: none;
    position: fixed;
    z-index: 2;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    max-width: 90vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    object-fit: contain; /* buong image, walang crop */
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
}

#zoomed-image.show {
    display: block;
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.05);
}

/* Upload icon: ensure clickable (keep hope-ui .upload-icone position: absolute) */
#modal-account-details .account-photo-upload-label {
    cursor: pointer;
    z-index: 10;
}
.change-photo-preview {
    width: 100%;
    max-width: 180px;
    height: 180px;
    object-fit: cover;
}
.change-photo-dropzone {
    min-height: 160px;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
}
.change-photo-dropzone.drag-over {
    background-color: rgba(var(--bs-primary-rgb), 0.08);
    border-color: var(--bs-primary) !important;
}
.border-dashed { border-style: dashed !important; }

/* Image hover effect */
#account_photo {
    width: 150px;
    height: 150px;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease; /* Smooth transition for zoom */
}

#account_photo:hover {
    transform: scale(1.1); /* Slight zoom effect on hover */
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3); /* Increase shadow on hover */
}

/* Passport Details modal – improved styling */
.passport-details-modal-content { border-radius: 12px; }
.passport-details-header {
    background: #4155FF;
    color: #fff;
}
.passport-details-header .modal-title,
.passport-details-header .modal-title i {
    color: #fff !important;
}
.passport-empty-icon { font-size: 4rem; opacity: 0.5; }
.passport-image-wrapper {
    background: #fff;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    padding: 12px;
    min-height: 280px;
}
.passport-detail-img {
    max-height: 300px;
    object-fit: contain;
    cursor: pointer;
    border-radius: 8px;
    transition: box-shadow 0.25s ease, transform 0.2s ease;
}
.passport-detail-img:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.15); }
.passport-hover-hint {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.6);
    color: #fff;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.2s ease;
}
.passport-image-wrapper:hover .passport-hover-hint { opacity: 1; }
.passport-details-card {
    background: #fff;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
}
.passport-details-table th {
    width: 130px;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #64748b;
    background: #f8fafc;
}
.passport-details-table td {
    padding: 12px 16px;
    font-size: 0.95rem;
    color: #1e293b;
}
.passport-details-table tr { border-bottom: 1px solid #e2e8f0; }
.passport-details-table tr:last-child { border-bottom: none; }
.passport-zoomed {
    display: none;
    position: fixed;
    z-index: 1100;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    max-width: 90vw;
    max-height: 85vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    object-fit: contain;
    box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    opacity: 0;
    transition: opacity 0.25s ease;
}
.passport-zoomed.show {
    display: block;
    opacity: 1;
}

#accountDetails {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
}

/* Header styles */
#accountDetails thead th {
    background: var(--bs-primary-bg-subtle);
    color: var(--bs-primary);
    font-weight: 500;
    padding: 12px 15px;
    text-align: left;
    border: none;
}

/* Row styles */
#accountDetails tbody tr {
    border-bottom: 1px solid #eee;
}

/* Cell styles */
#accountDetails td {
    padding: 12px 15px;
    color: #666;
}

#accountDetails tbody tr:hover {
  background-color: #f5f5f5 !important;
}



/* Balance column */
#accountDetails td:last-child {
    text-align: right;
    color: #333;
}


/* Footer total row */


#accountDetails tfoot th {
    padding: 10px;
    font-weight: 600;
  
    color: #333;
    background-color: #f4f6fa;
    border-top: 2px solid #dee2e6;
}
@media (max-width: 768px) {
    #accountDetails {
        font-size: 10px; /* Mas maliit sa mobile */
    }

    #accountDetails th,
    #accountDetails td {
        padding: 5px;
    }
}
/* Override Bootstrap .table-info to light-blue */
.table-info {
  background-color: #cce5ff !important;
}
</style>


<script>
(function () {
    const accountPhoto = document.getElementById('account_photo');
    const zoomedImage = document.getElementById('zoomed-image');
    const modalChangePhoto = document.getElementById('modal-change-photo');
    const prevImg = document.getElementById('change-photo-previous');
    const dropzone = document.getElementById('change-photo-dropzone');
    const fileInput = document.getElementById('change-photo-file-input');
    const placeholder = document.getElementById('change-photo-placeholder');
    const newPreview = document.getElementById('change-photo-new-preview');
    const saveBtn = document.getElementById('change-photo-save-btn');

    var changePhotoFile = null;

    // Zoom preview on hover
    accountPhoto.addEventListener('mouseover', function () {
        zoomedImage.src = accountPhoto.src;
        zoomedImage.classList.add('show');
    });
    accountPhoto.addEventListener('mouseout', function () {
        zoomedImage.classList.remove('show');
    });

    // Passport Details button
    var btnPassportDetails = document.getElementById('btn-passport-details');
    var modalPassportDetails = document.getElementById('modal-passport-details');
    if (btnPassportDetails && modalPassportDetails) {
        btnPassportDetails.addEventListener('click', function () {
            var accountId = document.getElementById('account_id_add') && document.getElementById('account_id_add').value;
            if (!accountId) {
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'warning', title: 'No account', text: 'Please open an account first.' });
                else alert('Please open an account first.');
                return;
            }
            var Modal = typeof bootstrap !== 'undefined' ? bootstrap.Modal : (typeof Bootstrap !== 'undefined' ? Bootstrap.Modal : null);
            if (Modal) Modal.getOrCreateInstance(modalPassportDetails).show();
            else $(modalPassportDetails).modal('show');
            document.getElementById('passport-details-loading').classList.remove('d-none');
            document.getElementById('passport-details-empty').classList.add('d-none');
            document.getElementById('passport-details-content').classList.add('d-none');
            fetch('/account_passport_details/' + accountId)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    document.getElementById('passport-details-loading').classList.add('d-none');
                    if (!data || (typeof data === 'object' && data.error)) {
                        document.getElementById('passport-details-empty').classList.remove('d-none');
                        return;
                    }
                    document.getElementById('passport-details-content').classList.remove('d-none');
                    document.getElementById('p-doc-type').textContent = data.DOCUMENT_TYPE || '—';
                    document.getElementById('p-country').textContent = data.COUNTRY_CODE || '—';
                    document.getElementById('p-passport-no').textContent = data.PASSPORT_NO || '—';
                    document.getElementById('p-full-name').textContent = data.FULL_NAME || '—';
                    document.getElementById('p-nationality').textContent = data.NATIONALITY || '—';
                    document.getElementById('p-dob').textContent = data.DATE_OF_BIRTH ? new Date(data.DATE_OF_BIRTH).toLocaleDateString() : '—';
                    document.getElementById('p-expiry').textContent = data.EXPIRY_DATE ? new Date(data.EXPIRY_DATE).toLocaleDateString() : '—';
                    document.getElementById('p-gender').textContent = data.GENDER || '—';
                    var img = document.getElementById('passport-detail-image');
                    if (data.PASSPORT_IMAGE) {
                        img.src = '/PassportUpload/' + data.PASSPORT_IMAGE;
                        img.style.display = '';
                    } else {
                        img.style.display = 'none';
                    }
                })
                .catch(function () {
                    document.getElementById('passport-details-loading').classList.add('d-none');
                    document.getElementById('passport-details-empty').classList.remove('d-none');
                });
        });
    }

    // Passport image zoom on hover (like Guest Portal face)
    var passportDetailImg = document.getElementById('passport-detail-image');
    var passportZoomed = document.getElementById('passport-zoomed-image');
    if (passportDetailImg && passportZoomed) {
        passportDetailImg.addEventListener('mouseover', function () {
            if (passportDetailImg.src && !passportDetailImg.src.endsWith('undefined')) {
                passportZoomed.src = passportDetailImg.src;
                passportZoomed.classList.add('show');
            }
        });
        passportDetailImg.addEventListener('mouseout', function () {
            passportZoomed.classList.remove('show');
        });
    }
    if (modalPassportDetails && passportZoomed) {
        modalPassportDetails.addEventListener('hidden.bs.modal', function () {
            passportZoomed.classList.remove('show');
        });
    }

    // Open change-photo modal when edit icon is clicked (JS so modal shows even when nested/sibling)
    var btnOpenChangePhoto = document.getElementById('btn-open-change-photo');
    if (btnOpenChangePhoto && modalChangePhoto) {
        btnOpenChangePhoto.addEventListener('click', function () {
            var Modal = typeof bootstrap !== 'undefined' ? bootstrap.Modal : (typeof Bootstrap !== 'undefined' ? Bootstrap.Modal : null);
            if (Modal) {
                Modal.getOrCreateInstance(modalChangePhoto).show();
            } else {
                $(modalChangePhoto).modal('show');
            }
        });
    }

    // When change-photo modal opens: show previous image, reset new
    if (modalChangePhoto) {
        modalChangePhoto.addEventListener('show.bs.modal', function () {
            prevImg.src = accountPhoto.src || '';
            prevImg.alt = 'Current';
            changePhotoFile = null;
            if (fileInput) fileInput.value = '';
            placeholder.classList.remove('d-none');
            newPreview.classList.add('d-none');
            newPreview.src = '';
            if (saveBtn) saveBtn.disabled = true;
        });
    }

    function setNewFile(file) {
        if (!file || !file.type.startsWith('image/')) return;
        changePhotoFile = file;
        var reader = new FileReader();
        reader.onload = function (e) {
            newPreview.src = e.target.result;
            newPreview.classList.remove('d-none');
            placeholder.classList.add('d-none');
            if (saveBtn) saveBtn.disabled = false;
        };
        reader.readAsDataURL(file);
    }

    // Click dropzone = open file picker
    if (dropzone && fileInput) {
        dropzone.addEventListener('click', function (e) {
            if (e.target === fileInput || e.target.closest('input')) return;
            fileInput.click();
        });
        fileInput.addEventListener('change', function () {
            var f = this.files && this.files[0];
            setNewFile(f);
        });
    }

    // Drag and drop
    if (dropzone) {
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function (ev) {
            dropzone.addEventListener(ev, function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (ev === 'dragenter' || ev === 'dragover') dropzone.classList.add('drag-over');
                else dropzone.classList.remove('drag-over');
                if (ev === 'drop') {
                    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
                    setNewFile(f);
                }
            });
        });
    }

    // Save button
    if (saveBtn) {
        saveBtn.addEventListener('click', function () {
            if (!changePhotoFile) return;
            var accountIdEl = document.getElementById('account_id_add');
            var accountId = accountIdEl && accountIdEl.value && accountIdEl.value.trim();
            if (!accountId) {
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Error', text: 'Account not found' });
                else alert('Account not found');
                return;
            }
            saveBtn.disabled = true;
            var formData = new FormData();
            formData.append('photo', changePhotoFile);
            fetch('/account/' + accountId + '/update_photo', { method: 'POST', body: formData })
                .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
                .then(function (result) {
                    if (result.ok && result.data.success) {
                        accountPhoto.src = newPreview.src;
                        zoomedImage.src = newPreview.src;
                        var modal = bootstrap.Modal.getInstance(modalChangePhoto);
                        if (modal) modal.hide();
                        if (typeof Swal !== 'undefined') Swal.fire({ icon: 'success', title: 'Photo saved', timer: 1500, showConfirmButton: false });
                    } else {
                        var msg = (result.data && result.data.error) ? result.data.error : 'Failed to save photo';
                        if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Error', text: msg });
                        else alert(msg);
                    }
                })
                .catch(function () {
                    if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to save photo' });
                    else alert('Failed to save photo');
                })
                .finally(function () { saveBtn.disabled = false; });
        });
    }
})();
</script>

