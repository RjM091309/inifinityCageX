<div class="modal fade" id="modal-edit-return-money" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="modal-default-popout" aria-hidden="true" style="z-index: 1060 !important;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="block-title text-white">Edit Return Money</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="edit_return_money">
                    <div class="row mb-2">
                        <div class="col-sm-12">
                            <input type="text" class="form-control" name="txtAmount" id="txtReturnMoneyAmount" 
                                placeholder="Amount" onkeypress="return onlyNumberKey(event)" data-type="number" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-sm-12">
                            <textarea class="form-control" name="txtDescription" id="txtReturnMoneyDescription"
                                placeholder="Description" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button id="btn-save-edit-return-money" type="submit" class="btn btn-sm btn-success">
                            <span class="btn-label">Save</span>
                        </button>                               
                        <button type="button" class="btn btn-sm btn-alt-secondary"
                            data-bs-dismiss="modal">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

