<div class="modal fade" id="modal-new-marker" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLiveLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg2" role="document">
        <div class="modal-content">
        <div class="modal-header bg-primary">
            <h5 class="modal-title text-white" id="staticBackdropLiveLabel"><%= __('dashboard_marker.title') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="add_marker_settlement" action="/" method="POST">
        <div class="modal-body">
             <div id="core-container">
                <div class="row mb-3 d-flex justify-content-center">
                    <span class="section-header text-center"><%= __('dashboard_marker.total_credits_issue') %></span>
                     <input  type="hidden"  id="AgentBalance" name="AgentBalance">
                    <div class="col-sm-12 mb-3">
                        <input type="text" class="form-control text-center" name="txtTotalMarkerIssue" id="txtTotalMarkerIssue" 
                        value="  <%- ( (+sqlMarkerIssueGame[0].TOTAL_ISSUE_GAME || 0) +
                        (+sqlMarkerIssueAccount[0].TOTAL_ISSUE_RECORD || 0) -
                        (+sqlNNChipsAccountMarker[0].TOTAL_NN_MARKER || 0) -
                        (+sqlMArkerReturnCash[0].MARKER_RETURN_CASH || 0) -
                        (+sqlMArkerReturnDeposit[0].MARKER_RETURN_DEPOSIT || 0) -
                        (+sqlChipsReturnMarker[0].CHIPS_RETURN_MARKER || 0) ).toLocaleString() %>" readonly/>    
                    </div>
                </div>
                <div class="row mb-1">
                    <div class="col-sm-6">
                        <label class="form-label text-muted small mb-1 text-center">Total Junket Credit</label>
                        <input type="text" class="form-control text-center" id="txtTotalJunketCredit" readonly />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small mb-1 text-center">Total Game Credit</label>
                        <input type="text" class="form-control text-center" id="txtTotalGameCredit" readonly />
                    </div>
                </div>

                <div class="row d-flex justify-content-center mb-2">
                    
                    <div class="col-sm-3 d-flex justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="return-source-credit" name="optReturnSource" value="credit">
                            <label class="form-check-label" for="return-source-credit"><%= __('dashboard_marker.tab_credit') %></label>
                        </div>
                    </div>
                    <div class="col-sm-3 d-flex justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="return-source-buyin" name="optReturnSource" value="buyin">
                            <label class="form-check-label" for="return-source-buyin"><%= __('dashboard_marker.tab_buyin') %></label>
                        </div>
                    </div>
                </div>

                <!-- Account # -->
                <div class="row justify-content-center mb-2">
                    <div class="col-sm-6">
                      
                            <select class="js-select2 form-select" name="txtAccountMarker" id="txtAccountMarker" style="width: 100%;" data-placeholder="<%= __('dashboard_marker.please_select') %>">
                                <option value=""><%= __('dashboard_marker.please_select') %></option>
                            </select>
                       
                    </div>
                    <div class="col-sm-6">
                      
                            <input type="text" class="form-control" placeholder="<%= __('dashboard_marker.credits_issue') %>" name="txtMarkerIssue" id="txtMarkerIssue" readonly />
                           
                      
                    </div>
                </div>
                <div class="row d-flex justify-content-center mb-2">
                    <div class="col-sm-6">
                    
                            <input type="text" class="form-control" placeholder="<%= __('dashboard_marker.credits_return') %>" name="txtMarkerReturn" id="txtMarkerReturn" required autocomplete="off" />
                      
                       
                    </div>
                    <div class="col-sm-6">
                       
                            <input type="text" class="form-control" placeholder="<%= __('dashboard_marker.balance') %>" name="txtMarkerBalance" id="txtMarkerBalance" readonly style="color: #0665d0;"/>
                           
                       
                    </div>
                </div>
            </div>
                
                <div class="row d-flex justify-content-center mb-2">
                    <div class="col-sm-12">
                        <input type="text" class="form-control" placeholder="<%= __('dashboard_marker.remarks_optional') %>" name="remarks" id="txtRemarks" maxlength="500" autocomplete="off" />
                    </div>
                </div>

                <!-- Radio Buttons -->
                <div class="row d-flex justify-content-center ">
                    <div class="col-sm-3 d-flex justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="cash" name="optTransType" value="11">
                            <label class="form-check-label" for="cash"><%= __('dashboard_marker.cash') %></label>
                        </div>
                    </div>
                    <div class="col-sm-3 d-flex justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input" style="border-color: #8a92a6 !important;" type="radio" id="deposit" name="optTransType" value="12">
                            <label class="form-check-label" for="deposit"><%= __('dashboard_marker.deposit') %></label>
                        </div>
                    </div>
                </div>

                <!-- Save / Close buttons positioned near the form -->
                <div class="row d-flex justify-content-end mt-3 mb-2">
                    <div class="col-auto">
                        <button id="submit_marker_settlement" type="submit" class="btn btn-sm btn-primary">
                            <%= __('dashboard_marker.save') %>
                        </button>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal">
                            <%= __('dashboard_marker.close') %>
                        </button>
                    </div>
                </div>
            <hr style="border: none; border-top: 0.2rem solid black;">

            <!-- 3 Tabs: Marker History, Junket Credit, Game Credit -->
            <ul class="nav nav-tabs marker-balance-tabs mb-2" id="marker-balance-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-marker-history" data-tab="marker-history" type="button" role="tab"><%= __('dashboard_marker.marker_history') %></button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-credit-balance" data-tab="credit" type="button" role="tab"><%= __('dashboard_marker.tab_credit') %></button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-buyin-balance" data-tab="buyin" type="button" role="tab"><%= __('dashboard_marker.tab_buyin') %></button>
                </li>
            </ul>

            <div id="marker-history-wrapper" class="marker-tab-panel mb-3" data-panel="marker-history">
                <div class="d-flex justify-content-end align-items-center mb-2">
                    <button type="button" id="export-excel" class="btn btn-sm btn-success-subtle"><%= __('dashboard_marker.export') %></button>
                </div>
                <table id="marker-tbl" class="table table-bordered table-responsive" style="width: 100%;">
                <thead>
                    <tr>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.account_name') %></th>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.amount') %></th>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.transaction_type') %></th>
                        <th class="d-none d-sm-table-cell" style="width: 200px !important;"><%= __('dashboard_marker.date') %></th>
                        <th class="d-none d-sm-table-cell"><%= __('dashboard_marker.remarks') %></th>
                        <th class="d-none d-sm-table-cell text-center" style="width: 60px;"><%= __('dashboard_marker.action') %></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                </table>
            </div>

            <div id="marker-accounts-credit-wrapper" class="marker-tab-panel mb-3" data-panel="credit" style="display: none;">
                <div class="table-responsive">
                    <table id="marker-accounts-credit-tbl" class="table table-bordered marker-balance-tbl" style="width:100%">
                        <thead>
                            <tr>
                                <th><%= __('dashboard_marker.account_name') %></th>
                                <th class="text-end"><%= __('dashboard_marker.balance') %></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot><tr><th></th><th class="text-end"></th></tr></tfoot>
                    </table>
                </div>
            </div>

            <div id="marker-accounts-buyin-wrapper" class="marker-tab-panel mb-3" data-panel="buyin" style="display: none;">
                <div class="table-responsive">
                    <table id="marker-accounts-buyin-tbl" class="table table-bordered marker-balance-tbl" style="width:100%">
                        <thead>
                            <tr>
                                <th><%= __('dashboard_marker.account_name') %></th>
                                <th class="text-end"><%= __('dashboard_marker.balance') %></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot><tr><th></th><th class="text-end"></th></tr></tfoot>
                    </table>
                </div>
            </div>
        </div>
        </form>
    </div>
    </div>

    <style>
        .modal-lg2 {
            max-width: 45% !important;
        }

         /* Base table styles */
  #marker-tbl {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
}

/* Header styles */
#marker-tbl thead th {
    background: var(--bs-primary-bg-subtle);
    color: var(--bs-primary);
    font-weight: 500;
    padding: 12px 15px;
    text-align: left;
    border: none;
}

/* Row styles */
#marker-tbl tbody tr {
    border-bottom: 1px solid #eee;
}

/* Cell styles */
#marker-tbl td {
    padding: 12px 15px;
    color: #666;
}

#marker-tbl tbody tr:hover {
  background-color: #f5f5f5 !important;
}

#modal-new-marker .marker-balance-tabs .nav-link {
  font-size: 0.875rem;
  color: #8a92a6;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 0.5rem 0.75rem;
}
#modal-new-marker .marker-balance-tabs .nav-link:hover { color: var(--bs-primary); }
#modal-new-marker .marker-balance-tabs .nav-link.active {
  color: var(--bs-primary);
  font-weight: 500;
  border-bottom-color: var(--bs-primary);
  background: transparent;
}
#modal-new-marker .marker-balance-tbl {
  width: 100%;
  font-size: 13px;
  border-collapse: collapse;
  border: 1px solid #dee2e6;
}
#modal-new-marker .marker-balance-tbl thead tr th { border-bottom: 1px solid #dee2e6; }
#modal-new-marker .marker-balance-tbl tbody tr:last-child td,
#modal-new-marker .marker-balance-tbl tbody td.dataTables_empty { border-bottom: 1px solid #dee2e6; }
#modal-new-marker .marker-balance-tbl tfoot tr th { border-bottom: 1px solid #dee2e6; }
#modal-new-marker .marker-balance-tbl thead th {
  background: var(--bs-primary-bg-subtle);
  color: var(--bs-primary);
  font-weight: 500;
  padding: 12px 15px;
  text-align: left;
  border: none;
}
#modal-new-marker .marker-balance-tbl tbody tr { border-bottom: 1px solid #eee; }
#modal-new-marker .marker-balance-tbl td { padding: 12px 15px; color: #666; }
#modal-new-marker .marker-balance-tbl tbody tr:hover { background-color: #f5f5f5 !important; }
#modal-new-marker .marker-balance-tbl tr.marker-balance-total-row td {
	border-top: 2px solid #dee2e6;
	background-color: #f4f6fa;
	padding: 10px 15px;
}
#modal-new-marker .marker-balance-tbl tfoot tr th {
	border-top: 2px solid #dee2e6;
	background-color: #f4f6fa;
	padding: 10px 15px;
}

/* Balance column */
#marker-tbl td:last-child {
    text-align: right;
    color: #333;
}


/* Footer total row */


#marker-tbl tfoot th {
    padding: 10px;
    font-weight: 600;
    text-align: right;
    color: #333;
    background-color: #f4f6fa;
    border-top: 2px solid #dee2e6;
}

#marker-tbl tfoot td {
    padding: 15px;
    font-weight: 600;
    text-align: right;
    color: var(--bs-primary);
}

.select2-container .select2-selection--single {
							height: calc(1.5em + 0.75rem + 6px);
						}

						.select2-container .select2-search--inline .select2-search__field {
							margin-top: 0;
							margin: 0.25rem 0.25rem 0.25rem 0;
							height: 1.375rem;
							line-height: 1.375rem;
						}

						.select2-container--default .select2-selection--single {
							border-color: #eee;

						}

						.select2-container--default .select2-selection--single .select2-selection__rendered {
							display: flex;
							align-items: center;
							padding-left: 0.75rem;
							height: calc(1.5em + 0.75rem + 6px);
							line-height: 1.5;
						}

						.select2-container--default .select2-selection--single .select2-selection__arrow {
							height: calc(1.5em + 0.75rem + 6px);
						}

						.select2-container--default .select2-selection--single .select2-selection__placeholder {
							color: #8A92A6;
						}

						.select2-container--default .select2-selection--multiple .select2-selection__rendered {
							padding-right: 0.75rem;
							padding-left: 0.75rem;
						}
    </style>

<!--EXCEL MIN JS-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>
<script>
window.markerTranslations = window.markerTranslations || {
	showing_entries: "<%= __('dashboard_marker.showing_entries') %>",
	delete: "<%= __('dashboard_marker.delete') %>",
	confirm_delete: "<%= __('dashboard_marker.confirm_delete') %>",
	yes_delete: "<%= __('dashboard_marker.yes_delete') %>",
	length_menu: "<%= __('dashboard_marker.length_menu') %>",
	info_empty: "<%= __('dashboard_marker.info_empty') %>",
	info_filtered: "<%= __('dashboard_marker.info_filtered') %>",
	first: "<%= __('dashboard_marker.first') %>",
	last: "<%= __('dashboard_marker.last') %>",
	previous: "<%= __('dashboard_marker.previous') %>",
	next: "<%= __('dashboard_marker.next') %>",
	search: "<%= __('dashboard_marker.search') %>",
	no_data_available: "<%= __('dashboard_marker.no_data_available') %>",
	total: "<%= __('dashboard_marker.total') %>"
};
</script>
<!-- Marker init runs from footer (after jQuery + marker_common.js) -->
<script>
window.__markerModalInit = function() {
    if (typeof window.MarkerCommon === 'undefined') return;
    window.MarkerCommon.init({
        tableSelector: '#marker-tbl',
        exportBtnSelector: '#export-excel',
        withForm: true,
        formOptions: {
            formSelector: '#add_marker_settlement',
            accountSelectSelector: '#txtAccountMarker',
            markerIssueSelector: '#txtMarkerIssue',
            markerReturnSelector: '#txtMarkerReturn',
            markerBalanceSelector: '#txtMarkerBalance',
            remarksSelector: '#txtRemarks',
            submitBtnSelector: '#submit_marker_settlement',
            agentBalanceSelector: '#AgentBalance',
            optTransTypeName: 'optTransType',
            optReturnSourceName: 'optReturnSource',
            selectPlaceholder: '<%= __("dashboard_marker.select_account") %>',
            dropdownParent: '#modal-new-marker',
            onSuccess: function() {
                if (typeof window.reloadData === "function") window.reloadData();
            }
        },
        disableSaveExportByPermission: true,
        modalSelector: '#modal-new-marker',
        reloadOnModalHidden: true
    });
};
</script>


