<%- include ('../partials/header'); -%>
<%- include('../partials/loader') %>
	<%- include ('../partials/sidebar'); -%>
		<%- include ('../partials/topbar'); -%>

			<div class="container-fluid content-inner mt-4">
				<div class="row">
					<div class="col-sm-12">
						<div class="card">
							<div class="card-header d-flex justify-content-between align-items-center">

								<h3 class="card-title"><div class="breadcrumb1 flat">
									<a href="/dashboard" ><span class="fa fa-home"></span></a>
									<a href="/telegramAPI" class="active"><%= __('telegram_api.telegram_api') %></a>
								</div></h3>

							</div>
							<div id="user-role" data-permissions="<%= permissions %>"></div>
							<div class="card-body">
								<div class="text-center mb-3">
									<h5 class="mb-0 text-muted"><%= __('telegram_api.telegram_api') %></h5>
								</div>
								
								<form id="update_telegramAPI">
									<div class="d-flex gap-2 mb-4">
										<input type="text" class="form-control"
											name="txtTelegramAPI" id="telegramAPI"
											placeholder="<%= __('telegram_api.telegram_api_placeholder') %>">
										<button type="submit" class="btn btn-success">
											<%= __('telegram_api.save') %>
										</button>
									</div>
								</form>

								<hr class="my-3">

								<div>
									<div class="d-flex align-items-center mb-2">
										<h6 class="mb-0 me-2"><%= __('telegram_api.telegram_bot_details') %></h6>
										<span id="bot-status" class="badge bg-secondary"><%= __('telegram_api.checking') %></span>
									</div>
									<div id="bot-details" class="alert alert-secondary small mb-0">
										<div class="text-muted"><%= __('telegram_api.loading_bot_details') %></div>
									</div>
								</div>

								<hr class="my-4">

								<!-- Chat IDs -->
								<div class="d-flex align-items-center justify-content-between mb-2">
									<h6 class="mb-0"><%= __('telegram_api.chat_ids_title') %></h6>
									<button type="button" class="btn btn-sm btn-success" id="btn-add-chat-id">
										<i class="fa fa-plus me-1"></i> <%= __('telegram_api.add_chat_id') %>
									</button>
								</div>
								<p class="text-muted small mb-3"><%= __('telegram_api.chat_ids_hint_before') %><code class="bg-light px-1 rounded text-dark border">/getchatid</code><%= __('telegram_api.chat_ids_hint_after') %></p>
								<div class="table-responsive">
									<table class="table table-bordered table-vcenter">
										<thead>
											<tr>
												<th style="width: 60px;">#</th>
												<th><%= __('telegram_api.chat_id') %></th>
												<th class="text-center" style="width: 140px;"><%= __('telegram_api.actions') %></th>
											</tr>
										</thead>
										<tbody id="chat-ids-tbody"></tbody>
									</table>
								</div>
								<div id="chat-ids-empty" class="text-muted text-center py-3" style="display: none;"><%= __('telegram_api.chat_ids_empty') %></div>

								<hr class="my-4">

								<!-- Employee Chat IDs -->
								<div class="d-flex align-items-center justify-content-between mb-2">
									<h6 class="mb-0"><%= __('telegram_api.employee_chat_ids_title') %></h6>
									<button type="button" class="btn btn-sm btn-success" id="btn-add-employee-chat-id">
										<i class="fa fa-plus me-1"></i> <%= __('telegram_api.add_employee_chat_id') %>
									</button>
								</div>
								<p class="text-muted small mb-3"><%= __('telegram_api.employee_chat_ids_hint_before') %><code class="bg-light px-1 rounded text-dark border">/getchatid</code><%= __('telegram_api.employee_chat_ids_hint_after') %></p>
								<div class="table-responsive">
									<table class="table table-bordered table-vcenter">
										<thead>
											<tr>
												<th style="width: 60px;">#</th>
												<th><%= __('telegram_api.employee_chat_id') %></th>
												<th class="text-center" style="width: 140px;"><%= __('telegram_api.actions') %></th>
											</tr>
										</thead>
										<tbody id="employee-chat-ids-tbody"></tbody>
									</table>
								</div>
								<div id="employee-chat-ids-empty" class="text-muted text-center py-3" style="display: none;"><%= __('telegram_api.employee_chat_ids_empty') %></div>

								<hr class="my-4">

								<!-- Management Chat IDs -->
								<div class="d-flex align-items-center justify-content-between mb-2">
									<h6 class="mb-0"><%= __('telegram_api.management_chat_ids_title') %></h6>
									<button type="button" class="btn btn-sm btn-success" id="btn-add-management-chat-id">
										<i class="fa fa-plus me-1"></i> <%= __('telegram_api.add_management_chat_id') %>
									</button>
								</div>
								<p class="text-muted small mb-3"><%= __('telegram_api.management_chat_ids_hint_before') %><code class="bg-light px-1 rounded text-dark border">/getchatid</code><%= __('telegram_api.management_chat_ids_hint_after') %></p>
								<div class="table-responsive">
									<table class="table table-bordered table-vcenter">
										<thead>
											<tr>
												<th style="width: 60px;">#</th>
												<th><%= __('telegram_api.management_chat_id') %></th>
												<th class="text-center" style="width: 140px;"><%= __('telegram_api.actions') %></th>
											</tr>
										</thead>
										<tbody id="management-chat-ids-tbody"></tbody>
									</table>
								</div>
								<div id="management-chat-ids-empty" class="text-muted text-center py-3" style="display: none;"><%= __('telegram_api.management_chat_ids_empty') %></div>
							</div>
						</div>
					</div>
				</div>
			</div>
	


			<!-- Modal: Add / Edit Chat ID -->
			<div class="modal fade" id="modal-chat-id" tabindex="-1" aria-labelledby="modal-chat-id-label" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title" id="modal-chat-id-label"><%= __('telegram_api.add_chat_id') %></h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<div class="modal-body">
							<div class="mb-2">
								<label for="input-chat-id" class="form-label"><%= __('telegram_api.chat_id') %></label>
								<input type="text" class="form-control" id="input-chat-id">
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-primary" id="btn-save-chat-id"><%= __('telegram_api.save') %></button>
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('telegram_api.cancel') %></button>
						
						</div>
					</div>
				</div>
			</div>

			<!-- Modal: Add / Edit Employee Chat ID -->
			<div class="modal fade" id="modal-employee-chat-id" tabindex="-1" aria-labelledby="modal-employee-chat-id-label" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title" id="modal-employee-chat-id-label"><%= __('telegram_api.add_employee_chat_id') %></h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<div class="modal-body">
							<div class="mb-2">
								<label for="input-employee-chat-id" class="form-label"><%= __('telegram_api.employee_chat_id') %></label>
								<input type="text" class="form-control" id="input-employee-chat-id">
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-primary" id="btn-save-employee-chat-id"><%= __('telegram_api.save') %></button>
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('telegram_api.cancel') %></button>
							
						</div>
					</div>
				</div>
			</div>

			<!-- Modal: Add / Edit Management Chat ID -->
			<div class="modal fade" id="modal-management-chat-id" tabindex="-1" aria-labelledby="modal-management-chat-id-label" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title" id="modal-management-chat-id-label"><%= __('telegram_api.add_management_chat_id') %></h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<div class="modal-body">
							<div class="mb-2">
								<label for="input-management-chat-id" class="form-label"><%= __('telegram_api.management_chat_id') %></label>
								<input type="text" class="form-control" id="input-management-chat-id">
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-primary" id="btn-save-management-chat-id"><%= __('telegram_api.save') %></button>
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('telegram_api.cancel') %></button>
							
						</div>
					</div>
				</div>
			</div>

			<%- include ('../partials/footer'); -%>

			<script>
				// Pass translations to JavaScript
				window.telegramAPITranslations = {
					checking: "<%= __('telegram_api.checking') %>",
					loading_bot_details: "<%= __('telegram_api.loading_bot_details') %>",
					bot_name: "<%= __('telegram_api.bot_name') %>",
					username: "<%= __('telegram_api.username') %>",
					open_bot: "<%= __('telegram_api.open_bot') %>",
					active: "<%= __('telegram_api.active') %>",
					unavailable: "<%= __('telegram_api.unavailable') %>",
					no_bot_details: "<%= __('telegram_api.no_bot_details') %>",
					error: "<%= __('telegram_api.error') %>",
					could_not_load: "<%= __('telegram_api.could_not_load') %>",
					success: "<%= __('telegram_api.success') %>",
					updated_successfully: "<%= __('telegram_api.updated_successfully') %>",
					ok: "<%= __('telegram_api.ok') %>",
					error_title: "<%= __('telegram_api.error_title') %>",
					failed_to_update: "<%= __('telegram_api.failed_to_update') %>",
					add_chat_id: "<%= __('telegram_api.add_chat_id') %>",
					edit_chat_id: "<%= __('telegram_api.edit_chat_id') %>",
					edit: "<%= __('telegram_api.edit') %>",
					delete: "<%= __('telegram_api.delete') %>",
					cancel: "<%= __('telegram_api.cancel') %>",
					enter_chat_id: "<%= __('telegram_api.enter_chat_id') %>",
					saved: "<%= __('telegram_api.saved') %>",
					delete_chat_id: "<%= __('telegram_api.delete_chat_id') %>",
					delete_chat_id_confirm: "<%= __('telegram_api.delete_chat_id_confirm') %>",
					deleted: "<%= __('telegram_api.deleted') %>",
					employee_chat_ids_title: "<%= __('telegram_api.employee_chat_ids_title') %>",
					add_employee_chat_id: "<%= __('telegram_api.add_employee_chat_id') %>",
					edit_employee_chat_id: "<%= __('telegram_api.edit_employee_chat_id') %>",
					employee_chat_id: "<%= __('telegram_api.employee_chat_id') %>",
					employee_chat_ids_hint_before: "<%= __('telegram_api.employee_chat_ids_hint_before') %>",
					employee_chat_ids_hint_after: "<%= __('telegram_api.employee_chat_ids_hint_after') %>",
					employee_chat_ids_empty: "<%= __('telegram_api.employee_chat_ids_empty') %>",
					enter_employee_chat_id: "<%= __('telegram_api.enter_employee_chat_id') %>",
					delete_employee_chat_id: "<%= __('telegram_api.delete_employee_chat_id') %>",
					delete_employee_chat_id_confirm: "<%= __('telegram_api.delete_employee_chat_id_confirm') %>",
					management_chat_ids_title: "<%= __('telegram_api.management_chat_ids_title') %>",
					add_management_chat_id: "<%= __('telegram_api.add_management_chat_id') %>",
					edit_management_chat_id: "<%= __('telegram_api.edit_management_chat_id') %>",
					management_chat_id: "<%= __('telegram_api.management_chat_id') %>",
					management_chat_ids_hint_before: "<%= __('telegram_api.management_chat_ids_hint_before') %>",
					management_chat_ids_hint_after: "<%= __('telegram_api.management_chat_ids_hint_after') %>",
					management_chat_ids_empty: "<%= __('telegram_api.management_chat_ids_empty') %>",
					enter_management_chat_id: "<%= __('telegram_api.enter_management_chat_id') %>",
					delete_management_chat_id: "<%= __('telegram_api.delete_management_chat_id') %>",
					delete_management_chat_id_confirm: "<%= __('telegram_api.delete_management_chat_id_confirm') %>"
				};
			</script>

				<script src="/assets/js/functions/telegramAPI.js"></script>