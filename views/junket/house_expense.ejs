        <!-- Main Container -->
        <div class="container-fluid content-inner mt-4">

            <div class="row">
                <div class="col-sm-12">
                    <div class="card">
                        <div id="user-role" data-permissions="<%= permissions %>"></div>
                        <div class="card-header border-bottom-0 d-flex flex-wrap justify-content-between align-items-center">
                            <div class="mb-2 mb-md-0">
                                <div class="breadcrumb1 flat">
                                    <a href="/dashboard"><span class="fa fa-home"></span></a>
                                    <a href="/house_expense" class="active"><%= __('house_expense.junket_expenses') %></a>
                                    <a href="#" id="btn-daily-settle"><%= __('house_expense.settle') || 'Settle' %></a>
                                </div>
                            </div>
                            <div class="d-flex">
                                <button type="button" class="btn btn-primary me-2" onclick="addHouseExpense()">
                                    <i class="fa fa-plus" aria-hidden="true"></i> <%= __('house_expense.new_expense') %>
                                </button>
                                <button type="button" class="btn btn-success me-2" onclick="returnMoney()">
                                    <i class="fa fa-undo" aria-hidden="true"></i> <%= __('house_expense.return_money') %>
                                </button>
                            </div>
                        </div>
       
                        <div class="card-body">
                            <div id="house-expense-analytics" class="mb-4">
                                <%
                                    const now = new Date();
                                    const pad = value => value.toString().padStart(2, '0');
                                    const todayStrValue = typeof todayStr !== 'undefined' ? todayStr : `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
                                    const initialDate = typeof defaultSettlementDate !== 'undefined' ? defaultSettlementDate : todayStrValue;
                                    const maxPickerDate = typeof maxSettlementDate !== 'undefined' ? maxSettlementDate : initialDate;
                                %>

                                <div class="row g-3 mb-3 align-items-stretch analytics-summary-row">
                                    <div class="col-12 col-lg-3 d-flex flex-column">
                                        <div class="analytics-date-filter h-100 flex-grow-1">
                                            <div class="filter-mode-container mb-2">
                                                <div class="d-flex align-items-center gap-3">
                                                    <label class="mb-0">
                                                        <input type="radio" name="filter-mode" value="settlement" checked id="filter-settlement">
                                                        <span class="ms-1">Settlement Date</span>
                                                    </label>
                                                    <label class="mb-0">
                                                        <input type="radio" name="filter-mode" value="daterange" id="filter-daterange">
                                                        <span class="ms-1">Date Range</span>
                                                    </label>
                                                </div>
                                            </div>

                                            <div id="settlement-date-wrapper" class="day-selector-wrapper">
                                                <div class="input-group" data-today="<%= todayStrValue %>" data-default-settlement-date="<%= initialDate %>" data-max-settlement-date="<%= maxPickerDate %>" data-settled-dates='<%= typeof settledDatesForMonth !== "undefined" ? JSON.stringify(settledDatesForMonth) : "[]" %>'>
                                                    <button type="button" id="btn-settlement-prev" class="btn btn-outline-secondary" title="Previous Date">
                                                        <i class="fa fa-chevron-left"></i>
                                                    </button>
                                                    <input type="text" id="settlement-date-picker" class="form-control text-center" placeholder="YYYY-MM-DD" value="<%= initialDate %>" readonly />
                                                    <button type="button" id="btn-settlement-next" class="btn btn-outline-secondary" title="Next Date">
                                                        <i class="fa fa-chevron-right"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div id="daterange-wrapper" class="day-selector-wrapper" style="display: none;">
                                                <div class="input-group">
                                                    <input type="text" id="daterange-picker" class="form-control text-center" placeholder="Select date range" autocomplete="off" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-lg-3 analytics-stat-col">
                                        <div class="analytics-stat-card">
                                            <div class="analytics-stat-label">Total Expenses</div>
                                            <div id="analytics-total-expense" class="analytics-stat-value">₱0</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-3 analytics-stat-col">
                                        <div class="analytics-stat-card">
                                            <div class="analytics-stat-label">Total Return Money</div>
                                            <div id="analytics-total-return" class="analytics-stat-value text-success">₱0</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-3 analytics-stat-col">
                                        <div class="analytics-stat-card">
                                            <div class="analytics-stat-label"><%= __('house_expense.total_net_expenses') || 'TOTAL NET EXPENSES' %></div>
                                            <div id="analytics-total-net" class="analytics-stat-value">₱0</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="analytics-panel">
                                            <div class="analytics-panel-title">Expense Breakdown by Category</div>
                                            <div id="analytics-category-breakdown" class="analytics-breakdown-list">
                                                <div class="text-muted small">No expense data yet.</div>
                                            </div>
                                            <div id="analytics-return-breakdown" class="analytics-return-breakdown"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
       
                            <table id="expense-tbl" class="table  nowrap small-text" style="width:100%"> 
                                <thead>
                                    <tr>
                                        <th><%= __('house_expense.name') %></th>
                                        <!-- Type column hidden per request
                                        <th><%= __('house_expense.type') %></th>
                                        -->
                                        <th><%= __('house_expense.receipt_no') %></th>
                                        <th><%= __('house_expense.description') %></th>
                                        <th><%= __('house_expense.amount') %></th>
                                        <th><%= __('house_expense.encoded_by') %></th>
                                        <th><%= __('house_expense.date_time') %></th>
                                        <th><%= __('house_expense.action') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="1"><%= __('house_expense.total_expenses') || 'TOTAL EXPENSES' %></th>
                                        <th id="TOTAL_EXPENSE_AMOUNT">₱0.00</th>
                                        <th colspan="5"></th>
                                    </tr>
                                    <tr>
                                        <th colspan="1"><%= __('house_expense.total_return_money') || 'TOTAL RETURN MONEY' %></th>
                                        <th id="TOTAL_RETURN_MONEY_AMOUNT">₱0.00</th>
                                        <th colspan="5"></th>
                                    </tr>
                                    <tr>
                                        <th colspan="1"><%= __('house_expense.total_net_expenses') || 'TOTAL NET EXPENSES' %></th>
                                        <th id="TOTAL_NET_EXPENSES_AMOUNT">₱0.00</th>
                                        <th colspan="5"></th>
                                    </tr>
                                </tfoot>
                            </table>
       
                            
       
                        </div>
                    </div>
                </div>
            </div>
        </div>
            
        
